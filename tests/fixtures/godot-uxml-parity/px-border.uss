.c { position: absolute; width: 80px; height: 56px; }
#sides { background-color: rgb(238, 238, 238); border-top-width: 1px; border-right-width: 2px; border-bottom-width: 3px; border-left-width: 4px;
  border-top-color: rgb(220, 30, 30); border-right-color: rgb(30, 160, 30); border-bottom-color: rgb(30, 30, 220); border-left-color: rgb(240, 140, 0); }
#round { background-color: rgb(255, 200, 140); border-width: 4px; border-color: rgb(50, 50, 50); border-radius: 10px; }
#corners { background-color: rgb(200, 220, 255); border-width: 2px; border-color: rgb(0, 100, 200);
  border-top-left-radius: 0; border-top-right-radius: 6px; border-bottom-right-radius: 14px; border-bottom-left-radius: 24px; }
#pill { height: 40px; background-color: rgb(50, 150, 50); border-radius: 20px; }
#circle { width: 56px; background-color: rgb(200, 50, 150); border-width: 3px; border-color: rgb(0, 0, 0); border-radius: 100px; }
#round-sides { background-color: rgb(250, 250, 200); border-width: 4px; border-radius: 12px;
  border-top-color: rgb(220, 30, 30); border-right-color: rgb(30, 160, 30); border-bottom-color: rgb(30, 30, 220); border-left-color: rgb(240, 140, 0); }
#thick { background-color: rgb(255, 255, 0); border-width: 8px; border-color: rgb(0, 0, 255); border-radius: 4px; }
#fraction { background-color: rgb(170, 170, 170); border-width: 1.5px; border-color: rgb(0, 0, 0); border-radius: 2.5px; }
#alpha { background-color: rgb(255, 0, 0); border-width: 6px; border-color: rgba(0, 0, 0, 0.5); }
#one-corner { background-color: rgb(120, 120, 220); border-top-left-radius: 40px; }
#over { background-color: rgb(120, 200, 200); border-width: 2px; border-color: rgb(0, 80, 80); border-top-left-radius: 60px; border-top-right-radius: 60px; }
#lr { background-color: rgb(230, 230, 230); border-left-width: 10px; border-right-width: 10px; border-left-color: rgb(200, 0, 0); border-right-color: rgb(0, 0, 200); border-radius: 15px; }
#tall { width: 30px; background-color: rgb(90, 90, 90); border-width: 2px; border-color: rgb(255, 128, 0); border-radius: 30px; }
#no-bg { border-width: 3px; border-color: rgb(0, 128, 0); border-radius: 8px; }
#half-alpha-bg { background-color: rgba(0, 0, 255, 0.5); border-width: 4px; border-color: rgba(255, 0, 0, 0.5); border-radius: 6px; }
#mixed-alpha { background-color: rgb(255, 255, 255); border-width: 5px; border-top-color: rgba(0, 0, 0, 0.25); border-right-color: rgba(0, 0, 0, 0.5); border-bottom-color: rgba(0, 0, 0, 0.75); border-left-color: rgb(0, 0, 0); }
