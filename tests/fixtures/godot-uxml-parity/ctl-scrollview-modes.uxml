<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:ScrollView name="sv-v" style="height: 80px; width: 120px;">
    <ui:VisualElement name="v-a" style="height: 60px;" />
    <ui:VisualElement name="v-b" style="height: 60px;" />
  </ui:ScrollView>
  <ui:ScrollView name="sv-h" mode="Horizontal" style="height: 60px; width: 120px;">
    <ui:VisualElement name="h-a" style="width: 100px;" />
    <ui:VisualElement name="h-b" style="width: 100px;" />
  </ui:ScrollView>
  <ui:ScrollView name="sv-vh" mode="VerticalAndHorizontal" style="height: 100px; width: 150px;">
    <ui:VisualElement name="vh-a" style="width: 200px; height: 80px;" />
    <ui:VisualElement name="vh-b" style="width: 50px; height: 80px;" />
  </ui:ScrollView>
</ui:UXML>
