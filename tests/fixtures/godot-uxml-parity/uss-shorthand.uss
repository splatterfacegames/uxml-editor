#wrap { flex-direction: row; flex-wrap: wrap; }
.b { width: 40px; height: 20px; }
#m1 { margin: 3px; padding: 1px; }
#m2 { margin: 3px 5px; padding: 1px 2px; }
#m3 { margin: 3px 5px 7px; padding: 1px 2px 3px; }
#m4 { margin: 1px 2px 3px 4px; padding: 4px 3px 2px 1px; }
#bw1 { border-width: 2px; }
#bw4 { border-width: 1px 2px 3px 4px; }
#bc2 { border-color: red blue; border-width: 1px; }
#bc3 { border-color: red blue green; border-width: 1px; }
#br1 { border-radius: 4px; }
#br2 { border-radius: 2px 6px; }
#br3 { border-radius: 1px 2px 3px; }
#br4 { border-radius: 1px 2px 3px 4px; }
#br-pct { border-radius: 25%; }
#f1 { flex: 1; }
#f2 { flex: 2 3; }
#f3 { flex: 1 1 30px; }
#f4 { flex: auto; }
#f5 { flex: none; }
#f6 { flex: 25px; }
#f7 { flex: 1 25%; }
#f8 { flex: 0 auto; }
#tr1 { transition: width 1s; }
#tr2 { transition: opacity 0.5s ease-in-out 100ms, color 2s linear; }
#tr3 { transition-property: margin-left, all; transition-duration: 1s, 200ms; transition-timing-function: ease-out-bounce; transition-delay: -50ms; }
