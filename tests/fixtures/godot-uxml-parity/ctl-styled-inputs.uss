.unity-base-slider__dragger {
  width: 12px;
  background-color: rgb(255, 0, 0);
}
#unity-tracker {
  height: 10px;
  margin-top: -5px;
  border-color: rgb(0, 0, 255);
}
.unity-base-slider__fill {
  background-color: rgb(0, 200, 0);
}
.unity-base-field__label {
  min-width: 80px;
}
#unity-text-input {
  padding: 4px;
  background-color: rgb(255, 255, 200);
}
.unity-text-field .unity-text-element {
  color: rgb(200, 0, 0);
  -unity-text-align: middle-right;
}
IntegerInput {
  border-width: 3px;
}
.unity-base-popup-field__input {
  background-color: rgb(220, 220, 255);
  padding-left: 2px;
}
.unity-base-popup-field__arrow {
  width: 20px;
}
.unity-composite-field__field {
  margin-left: 10px;
}
.unity-min-max-slider__dragger {
  background-color: rgb(0, 128, 0);
}
.unity-min-max-slider__min-thumb {
  width: 12px;
}
