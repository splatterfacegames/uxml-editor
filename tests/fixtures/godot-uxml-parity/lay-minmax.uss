.row { flex-direction: row; width: 300px; height: 30px; }
.col { height: 100px; width: 40px; }
.g { flex-grow: 1; }
#grow-max { max-width: 50px; }
#shrink-min { width: 200px; min-width: 120px; flex-shrink: 1; }
#conf { width: 50px; min-width: 80px; max-width: 30px; height: 10px; }
#conf-h { height: 50px; min-height: 5px; max-height: 15px; width: 10px; }
#minauto { min-width: auto; width: 0; height: 5px; }
#cg-min { min-height: 70px; }
#ar1 { aspect-ratio: 2; height: 20px; }
#ar2 { aspect-ratio: 1; width: 25px; max-height: 10px; }
#ar3 { aspect-ratio: 0.5; height: 30px; min-width: 20px; }
.big { width: 150px; height: 10px; flex-shrink: 1; }
#sh1 { flex-shrink: 0; }
#sh3 { flex-shrink: 3; }
