<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:ToggleButtonGroup name="tbg">
    <ui:Button name="tbg-a" text="A" />
    <ui:Button name="tbg-b" text="B" />
  </ui:ToggleButtonGroup>
  <ui:ToggleButtonGroup name="tbg-multi" is-multiple-selection="true" allow-empty-selection="true">
    <ui:Button name="tbg-m1" text="One" />
    <ui:Button name="tbg-m2" text="Two" />
  </ui:ToggleButtonGroup>
</ui:UXML>
