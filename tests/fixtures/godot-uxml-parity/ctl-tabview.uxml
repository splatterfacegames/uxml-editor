      <ui:Label name="a-body" text="Alpha" />
    </ui:Tab>
    <ui:Tab name="tab-b" label="Second" closeable="true">
      <ui:Label name="b-body" text="Beta" />
    </ui:Tab>
    <ui:Tab name="tab-c" label="Third" />
  </ui:TabView>
  <ui:Tab name="loose" label="Loose" />
</ui:UXML>
