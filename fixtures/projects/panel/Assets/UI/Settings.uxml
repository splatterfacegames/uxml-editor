<?xml version="1.0" encoding="utf-8"?>
<!-- A settings screen that fills the panel (godot-uxml bench/parity/scaled/cases/scl-settings). -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="Settings.uss" />
  <ui:VisualElement name="screen" class="screen">
    <ui:VisualElement name="card" class="card">
      <ui:Label name="title" text="Settings" class="title" />
      <ui:Label name="subtitle" text="Video, audio and controls" class="subtitle" />
      <ui:VisualElement name="resolution" class="row">
        <ui:Label text="Resolution" class="key" />
        <ui:Label text="1920 x 1080" class="value" />
      </ui:VisualElement>
      <ui:VisualElement name="quality" class="row">
        <ui:Label text="Texture quality" class="key" />
        <ui:Label text="High" class="value" />
      </ui:VisualElement>
      <ui:Toggle name="vsync" label="V-Sync" value="true" />
      <ui:Toggle name="subtitles" label="Subtitles" />
      <ui:Slider name="volume" label="Master volume" low-value="0" high-value="100" value="80" />
      <ui:TextField name="player" label="Player name" value="Player One" />
      <ui:VisualElement name="bar" class="bar"><ui:VisualElement class="fill" /></ui:VisualElement>
      <ui:VisualElement name="footer" class="footer">
        <ui:Button name="reset" text="Reset" />
        <ui:Button name="apply" text="Apply" class="primary" />
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
