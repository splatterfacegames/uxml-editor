.screen { flex-grow: 1; align-items: center; justify-content: center; background-color: rgb(32, 36, 44); }
.card { width: 40%; min-width: 360px; max-width: 900px; padding: 16px 20px; background-color: rgb(46, 52, 64);
        border-width: 1px; border-color: rgb(76, 86, 106); border-radius: 8px; }
.title { font-size: 28px; color: rgb(236, 239, 244); -unity-font-style: bold; }
.subtitle { font-size: 13px; color: rgb(170, 176, 190); margin-bottom: 8px; }
.row { flex-direction: row; justify-content: space-between; margin: 3px 0; padding: 2.5px 4px; border-bottom-width: 0.5px; border-color: rgb(76, 86, 106); }
.key { color: rgb(216, 222, 233); }
.value { color: rgb(136, 192, 208); -unity-text-align: middle-right; }
.unity-toggle, .unity-slider, .unity-text-field { margin: 4px 0; }
.unity-base-field__label { color: rgb(216, 222, 233); }
.bar { height: 6.5px; margin: 10px 0; background-color: rgb(59, 66, 82); border-radius: 3px; }
.fill { width: 64%; height: 100%; background-color: rgb(163, 190, 140); border-radius: 3px; }
.footer { flex-direction: row; justify-content: flex-end; margin-top: 12px; }
.primary { background-color: rgb(94, 129, 172); color: rgb(255, 255, 255); }
