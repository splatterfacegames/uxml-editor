/* Inspector document (a generated skeleton, updated in place). */

.hidden {
    display: none;
}

/* Keeps its space: a visibility change needs no layout. */
.invisible {
    visibility: hidden;
}

.inspector {
    flex-grow: 1;
    background-color: rgb(56, 56, 56);
}

/* Over the (invisible) content. */
.empty {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    margin: 12px;
    color: rgb(160, 160, 160);
    white-space: normal;
}

/* The labels that change per selection have a fixed height and fill the
   width, so a new text needs no layout. */
.title {
    height: 24px;
    padding-left: 8px;
    padding-top: 6px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(230, 230, 230);
    overflow: hidden;
}

.subtitle {
    height: 18px;
    color: rgb(140, 140, 140);
    padding-left: 8px;
    margin-bottom: 6px;
    overflow: hidden;
}

.section {
    margin-top: 2px;
    border-top-width: 1px;
    border-top-color: rgb(36, 36, 36);
}

.row {
    flex-direction: row;
    align-items: center;
    padding-right: 4px;
}

.field {
    flex-grow: 1;
    flex-shrink: 1;
    margin-top: 1px;
    margin-bottom: 1px;
}

.type-field > .unity-label {
    min-width: 120px;
    width: 120px;
}

.row-label {
    width: 124px;
    min-width: 124px;
    height: 18px;
    padding-left: 4px;
    overflow: hidden;
    -unity-text-align: middle-left;
}

.row-label.unset {
    color: rgb(150, 150, 150);
}

.remove {
    width: 20px;
    height: 18px;
    padding: 0;
    margin-left: 2px;
}

.add-row {
    flex-direction: row;
    padding-right: 4px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.add-name {
    width: 130px;
    flex-shrink: 0;
}

.add-value {
    flex-grow: 1;
    flex-shrink: 1;
}

.add-button {
    width: 44px;
}

.hint {
    color: rgb(140, 140, 140);
    padding-left: 4px;
    margin-top: 2px;
    margin-bottom: 2px;
    -unity-font-style: italic;
}

.readout {
    height: 18px;
    overflow: hidden;
    padding-left: 4px;
    color: rgb(200, 200, 200);
}
