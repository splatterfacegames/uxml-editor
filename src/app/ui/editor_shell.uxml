<?xml version="1.0" encoding="utf-8"?>
<!--
  The editor window. godot-uxml renders this document with the Unity
  editor dark skin. Native Godot controls go into the *-host elements:
  the canvas (a SubViewport), the source view (CodeEdit) and the inspector
  (a second godot-uxml document, updated in place) and the document tabs
  (a small godot-uxml document of its own). The timeline tracks are an
  IMGUIContainer that the editor draws (UxmlDocument.set_imgui_handler).
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
  <Style src="editor_shell.uss" />
  <ui:VisualElement name="window" class="window">
    <uie:Toolbar name="toolbar" class="main-toolbar">
      <uie:ToolbarButton name="open-button" text="Open Project…" tooltip="Open a project directory (Ctrl+O)" />
      <uie:ToolbarButton name="save-button" text="Save" tooltip="Save the active document and its stylesheets (Ctrl+S)" />
      <uie:ToolbarButton name="save-all-button" text="Save All" tooltip="Save every changed file (Ctrl+Shift+S)" />
      <uie:ToolbarSpacer />
      <uie:ToolbarButton name="undo-button" text="Undo" tooltip="Undo (Ctrl+Z)" />
      <uie:ToolbarButton name="redo-button" text="Redo" tooltip="Redo (Ctrl+Y)" />
      <uie:ToolbarMenu name="edit-menu" text="Edit" tooltip="Structure commands for the selection" />
      <uie:ToolbarSpacer />
      <uie:ToolbarMenu name="preset-menu" text="1280 × 720" tooltip="Screen size of the canvas" />
      <uie:ToolbarMenu name="theme-menu" text="Auto theme" tooltip="Theme the document renders with" />
      <uie:ToolbarSpacer />
      <uie:ToolbarButton name="zoom-out-button" text="−" tooltip="Zoom out (Ctrl+-)" />
      <ui:Label name="zoom-label" class="zoom-label" text="100%" />
      <uie:ToolbarButton name="zoom-in-button" text="+" tooltip="Zoom in (Ctrl+=)" />
      <uie:ToolbarButton name="fit-button" text="Fit" tooltip="Fit the screen in the canvas (F)" />
      <uie:ToolbarSpacer />
      <uie:ToolbarToggle name="snap-toggle" text="Snap" value="true" tooltip="Snap moves and resizes to siblings, the parent and the grid (Alt or Ctrl while dragging turns snapping off)" />
      <uie:ToolbarMenu name="grid-menu" text="Grid 8 px" tooltip="Pixel grid for snapping" />
      <uie:ToolbarToggle name="preview-toggle" text="Preview" tooltip="Send mouse and keyboard input to the document (Ctrl+P)" />
      <uie:ToolbarToggle name="states-toggle" text="States" tooltip="Show the state-machine panel: the interaction states of the selection" />
      <uie:ToolbarSpacer class="grow" />
      <ui:Label name="document-label" class="document-label" text="No project" />
    </uie:Toolbar>
    <ui:TwoPaneSplitView name="main-split" fixed-pane-index="0" fixed-pane-initial-dimension="260" class="grow">
      <ui:TwoPaneSplitView name="left-split" orientation="Vertical" fixed-pane-index="0" fixed-pane-initial-dimension="150">
        <ui:VisualElement class="panel">
          <ui:Label class="panel-header" text="Project" />
          <ui:ListView name="files-list" fixed-item-height="20" selection-type="Single" class="grow panel-list" />
        </ui:VisualElement>
        <ui:TwoPaneSplitView name="hier-split" orientation="Vertical" fixed-pane-index="1" fixed-pane-initial-dimension="300">
          <ui:VisualElement class="panel">
            <ui:Label class="panel-header" text="Hierarchy" />
            <ui:TreeView name="hierarchy-tree" auto-expand="true" fixed-item-height="20" selection-type="Multiple" class="grow panel-list" />
          </ui:VisualElement>
          <ui:VisualElement class="panel">
            <ui:VisualElement class="panel-header-row">
              <ui:Label class="panel-header" text="Library" />
              <uie:ToolbarSearchField name="palette-search" class="palette-search grow" is-delayed="true" tooltip="Filter the elements" />
            </ui:VisualElement>
            <ui:TreeView name="palette-tree" fixed-item-height="20" selection-type="Single" class="grow panel-list" tooltip="Double-click or Enter: insert at the selection. Drag: insert at the drop position." />
          </ui:VisualElement>
        </ui:TwoPaneSplitView>
      </ui:TwoPaneSplitView>
      <ui:TwoPaneSplitView name="right-split" fixed-pane-index="1" fixed-pane-initial-dimension="440">
        <ui:TwoPaneSplitView name="center-split" orientation="Vertical" fixed-pane-index="1" fixed-pane-initial-dimension="420">
          <ui:VisualElement class="panel">
            <ui:VisualElement name="tabs-host" class="host tabs-host" />
            <ui:Label name="canvas-header" class="panel-header" text="Canvas" />
            <ui:VisualElement name="canvas-host" class="host grow" />
          </ui:VisualElement>
          <ui:TwoPaneSplitView name="lower-split" orientation="Vertical" fixed-pane-index="0" fixed-pane-initial-dimension="150">
          <ui:TwoPaneSplitView name="states-split" fixed-pane-index="0" fixed-pane-initial-dimension="0" class="grow states-closed">
          <ui:VisualElement name="sm-panel" class="panel hidden">
            <ui:VisualElement class="panel-header-row">
              <ui:Label class="panel-header sm-header" text="States" />
              <ui:Label name="sm-target" class="sm-target" text="" />
              <uie:ToolbarButton name="sm-close" class="tl-button" text="×" tooltip="Close the panel. The canvas shows the state of the source again." />
            </ui:VisualElement>
            <ui:IMGUIContainer name="sm-graph" class="grow sm-graph" tooltip="A click on a state forces it on the canvas. A click on an arrow plays the change. Filled: rules style the state. Dashed: no rule. A solid arrow has a transition; a dashed arrow is instant." />
            <ui:VisualElement class="sm-info-row">
              <ui:Label name="sm-info" class="sm-info" text="" />
            </ui:VisualElement>
          </ui:VisualElement>
          <ui:VisualElement name="timeline-panel" class="panel">
            <ui:VisualElement class="panel-header-row timeline-bar">
              <ui:Label class="panel-header timeline-header" text="Timeline" />
              <uie:ToolbarButton name="tl-restart" class="tl-button" text="|◀" tooltip="Back to the start" />
              <uie:ToolbarButton name="tl-play" class="tl-button" text="▶" tooltip="Play or pause the transitions from the From state to the To state" />
              <uie:ToolbarToggle name="tl-loop" text="Loop" tooltip="Play again from the start at the end" />
              <uie:ToolbarMenu name="tl-speed" class="tl-speed" text="1×" tooltip="Playback speed" />
              <ui:Label name="tl-time" class="tl-time" text="0.00 s" />
              <ui:Label class="tl-caption" text="From" />
              <ui:TextField name="tl-from" class="tl-cond" is-delayed="true" tooltip="The start state: classes and pseudo-states, for example .menu-button or .menu-button:hover" />
              <uie:ToolbarMenu name="tl-from-menu" class="tl-cond-menu" text="" tooltip="Choose the start state" />
              <ui:Label class="tl-caption" text="→" />
              <ui:TextField name="tl-to" class="tl-cond" is-delayed="true" tooltip="The end state: classes and pseudo-states" />
              <uie:ToolbarMenu name="tl-to-menu" class="tl-cond-menu" text="" tooltip="Choose the end state" />
              <uie:ToolbarMenu name="tl-scope" class="tl-scope" text="Selection" tooltip="Show the transitions of the selection or of the whole document" />
              <ui:Label name="tl-info" class="tl-info" text="" />
            </ui:VisualElement>
            <ui:IMGUIContainer name="tl-tracks" class="grow tl-tracks" />
          </ui:VisualElement>
          </ui:TwoPaneSplitView>
          <ui:VisualElement class="panel">
            <ui:VisualElement class="panel-header-row">
              <ui:Label class="panel-header" text="Source" />
              <uie:ToolbarMenu name="source-file-menu" class="source-file-menu" text="(no file)" tooltip="File shown in the source view" />
              <ui:Label name="source-state" class="source-state grow" text="" />
            </ui:VisualElement>
            <ui:TwoPaneSplitView name="source-split" fixed-pane-index="1" fixed-pane-initial-dimension="440" class="grow">
              <ui:VisualElement name="source-host" class="host" />
              <ui:VisualElement class="panel">
                <ui:VisualElement class="panel-header-row">
                  <ui:Label name="diagnostics-header" class="panel-header diagnostics-header" text="Diagnostics" />
                  <uie:ToolbarMenu name="diag-severity-menu" class="diag-menu" text="All severities" tooltip="Show one severity" />
                  <uie:ToolbarMenu name="diag-file-menu" class="diag-menu grow" text="All files" tooltip="Show one file" />
                  <uie:ToolbarMenu name="diag-source-menu" class="diag-menu" text="All sources" tooltip="Show the diagnostics of godot-uxml (import) or of the editor" />
                </ui:VisualElement>
                <ui:ListView name="diagnostics-list" fixed-item-height="18" selection-type="Single" class="grow panel-list" />
              </ui:VisualElement>
            </ui:TwoPaneSplitView>
          </ui:VisualElement>
          </ui:TwoPaneSplitView>
        </ui:TwoPaneSplitView>
        <ui:VisualElement class="panel">
          <ui:Label class="panel-header" text="Inspector" />
          <ui:VisualElement name="inspector-host" class="host grow" />
        </ui:VisualElement>
      </ui:TwoPaneSplitView>
    </ui:TwoPaneSplitView>
    <ui:VisualElement name="status-bar" class="status-bar">
      <ui:Label name="status-label" class="status-label status-message" text="Open a project directory to begin." />
      <ui:Label name="history-label" class="status-label history-label" text="" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
