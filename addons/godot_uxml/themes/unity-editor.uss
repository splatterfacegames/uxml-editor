/*
 * godot-uxml editor theme: geometry (both skins).
 *
 * Written by godot-uxml from values measured in Unity 6000.3.24f1 in an
 * editor panel (EditorPanel with the common editor sheet of the dark or
 * the light skin, pixelsPerPoint 1), using tools/unity-dump. The dumps are
 * bench/parity/unity/ed-*.json. This is not Unity's stylesheet: only the
 * measured values are recorded here, as rules on Unity's documented class
 * and part names.
 *
 * For a document with editor controls (UxmlDocument.editor_theme),
 * UxmlTheme attaches this sheet in place of the runtime theme
 * (unity-default.uss), followed by the colour sheet of the skin
 * (unity-editor-dark.uss or unity-editor-light.uss). The container
 * controls keep their structure sheet and their runtime look
 * (unity-structure.uss, unity-default-containers.uss).
 *
 * The images are godot-uxml's own SVGs.
 */

UXML {
  font-size: 12px;
}

/* SetEnabled(false) / enabled="false": the element itself dims. */
.unity-disabled {
  opacity: 0.5;
}

/* ---- Label, TextElement ---------------------------------------------- */

.unity-label {
  margin: 0;
  padding: 0 2px 0 1px;
  flex-grow: 0;
  flex-shrink: 0;
  white-space: nowrap;
}

/* ---- Button ---------------------------------------------------------- */

.unity-button {
  margin: 1px 3px;
  padding: 1px 6px;
  border-width: 1px;
  border-radius: 3px;
  flex-grow: 0;
  flex-shrink: 0;
  font-size: 12px;
  -unity-text-align: middle-center;
  white-space: nowrap;
}

/* ---- BaseField ------------------------------------------------------- */

.unity-base-field {
  flex-direction: row;
  margin: 1px 3px;
  flex-shrink: 0;
  overflow: hidden;
}

.unity-base-field__label {
  min-width: 120px;
  margin: 0 2px 0 0;
  padding: 2px 2px 0 1px;
  overflow: hidden;
  text-overflow: ellipsis;
}

.unity-base-field__input {
  flex-grow: 1;
  flex-shrink: 0;
  flex-basis: 0%;
  margin: 0;
  overflow: hidden;
}

/* ---- Box, GroupBox, PopupWindow, button groups ------------------------ */

.unity-box {
  border-width: 1px;
}

.unity-group-box {
  margin: 6px 3px 1px 3px;
  padding: 5px 0 5px 3px;
  flex-shrink: 0;
}

.unity-group-box__label {
  margin-top: -5px;
  margin-bottom: 5px;
}

.unity-radio-button-group {
  flex-shrink: 0;
}

.unity-popup-window {
  margin: 0;
  padding: 3px 0 0 0;
  border-width: 1px;
  border-radius: 8px 8px 0 0;
  -unity-text-align: upper-center;
}

.unity-popup-window__content-container {
  margin: 0;
  padding: 24px 4px 4px 4px;
  -unity-text-align: upper-left;
}

.unity-toggle-button-group {
  align-items: center;
}

.unity-toggle-button-group > .unity-base-field__input {
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: auto;
}

.unity-button-group {
  flex-direction: row;
  flex-grow: 0;
  flex-shrink: 0;
  flex-basis: auto;
}

.unity-button-group__button--left {
  margin-left: 0;
  margin-right: 0;
  border-right-width: 0;
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
}

.unity-button-group__button--mid {
  margin-left: 0;
  margin-right: 0;
  border-left-width: 1px;
  border-right-width: 0;
  border-radius: 0;
}

.unity-button-group__button--right {
  margin-left: 0;
  border-left-width: 1px;
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
}

/* ---- Toggle, RadioButton --------------------------------------------- */

.unity-toggle {
  margin-top: 1px;
  margin-bottom: 3px;
}

.unity-toggle__label {
  padding-top: 0;
  padding-bottom: 0;
}

.unity-toggle__input {
  flex-direction: row;
  flex-basis: auto;
}

.unity-toggle__checkmark {
  width: 14px;
  height: 14px;
  margin: 0;
  padding: 0;
  border-width: 0;
  border-radius: 0;
  flex-grow: 0;
  flex-shrink: 0;
  align-self: center;
}

.unity-toggle__text {
  margin: 0 0 0 1px;
  padding: 0 2px 0 1px;
  align-self: center;
  flex-grow: 1;
}

.unity-radio-button {
  margin-top: 1px;
  margin-bottom: 3px;
}

.unity-radio-button__label {
  padding-top: 0;
  padding-bottom: 0;
}

.unity-radio-button__input {
  flex-direction: row;
  flex-basis: auto;
}

.unity-radio-button__checkmark-background {
  width: 12px;
  height: 12px;
  margin: 0 2px 0 0;
  padding: 2px 0 0 0;
  border-width: 1px;
  border-radius: 6px;
  flex-grow: 0;
  flex-shrink: 0;
  align-self: center;
}

.unity-radio-button__checkmark {
  width: 6px;
  height: 6px;
  margin: 0;
  border-width: 0;
  border-radius: 3px;
  flex-grow: 0;
  flex-shrink: 0;
  align-self: center;
  background-image: none;
}

.unity-radio-button__text {
  margin: 0 0 0 1px;
  align-self: center;
}

/* ---- Text fields ----------------------------------------------------- */

.unity-base-text-field {
  white-space: nowrap;
}

.unity-base-text-field__input {
  margin: 0;
  padding: 1px 2px 0 2px;
  border-width: 1px;
  border-radius: 3px;
  flex-grow: 1;
  flex-shrink: 1;
  -unity-overflow-clip-box: content-box;
}

.unity-base-text-field__input--single-line {
  flex-direction: row;
  flex-shrink: 1;
  -unity-text-align: middle-left;
  overflow: scroll;
}

.unity-text-element--inner-input-field-component {
  margin: 0;
  padding: 0 2px;
  flex-grow: 1;
  flex-shrink: 0;
}

/* ---- Popup fields ---------------------------------------------------- */

.unity-base-popup-field__input,
.unity-enum-field__input {
  flex-direction: row;
  padding: 0 3px 1px 3px;
  border-width: 1px;
  border-radius: 3px;
  -unity-text-align: middle-left;
}

.unity-base-popup-field__input {
  min-width: 55px;
}

.unity-base-popup-field__text,
.unity-enum-field__text {
  margin: 0;
  padding: 0;
  flex-grow: 1;
  -unity-text-align: middle-left;
  white-space: nowrap;
  overflow: hidden;
}

.unity-base-popup-field__arrow,
.unity-enum-field__arrow {
  width: 12px;
  height: 12px;
  margin: 0;
  align-self: center;
}

/* ---- Composite fields ------------------------------------------------ */

.unity-composite-field > .unity-composite-field__input {
  flex-direction: row;
  flex-wrap: nowrap;
  flex-grow: 1;
  flex-shrink: 0;
  flex-basis: auto;
  margin-right: 0;
}

.unity-composite-field__field {
  min-width: 0;
  flex-direction: row;
  flex-grow: 1;
  flex-shrink: 0;
  flex-basis: 0%;
  margin: 0;
}

.unity-composite-field__input .unity-composite-field__field {
  margin-right: 4px;
}

#unity-z-input.unity-composite-field__field {
  margin-right: 0;
}

.unity-composite-field__field > .unity-base-field__label {
  min-width: 17px;
  margin-right: 0;
  flex-grow: 0;
  flex-shrink: 0;
  flex-basis: 17px;
}

.unity-composite-field__field-spacer {
  flex-direction: row;
  flex-grow: 1;
  flex-shrink: 0;
  flex-basis: auto;
  overflow: hidden;
}

.unity-base-field--no-label .unity-composite-field__field-spacer {
  position: absolute;
}

.unity-composite-field__field--first > .unity-base-field__label {
  margin-left: 0;
  margin-right: 0;
  padding-left: 1px;
}

/* ---- Slider ---------------------------------------------------------- */

.unity-base-slider__input {
  flex-grow: 1;
  flex-shrink: 0;
  flex-basis: auto;
  overflow: visible;
}

.unity-base-slider--horizontal {
  overflow: visible;
}

.unity-base-slider--horizontal .unity-base-slider__input {
  flex-direction: row;
  height: 100%;
}

.unity-base-slider--horizontal .unity-base-slider__tracker {
  top: 6px;
  height: 2px;
  margin: 2px 1px 2px 0;
  border-width: 0;
  border-radius: 0;
}

.unity-base-slider--horizontal .unity-base-slider__dragger {
  width: 10px;
  height: 10px;
  margin: -2px 0 0 0;
  padding: 0;
  border-width: 1px;
  border-radius: 5px;
}

.unity-base-slider__dragger-border {
  width: 0;
  height: 0;
  margin: 0;
  padding: 0;
  border-width: 0;
  border-radius: 8px;
  position: absolute;
}

.unity-base-slider--horizontal .unity-base-slider__dragger-border {
  margin: 0 0 0 -4px;
}

.unity-base-slider__input:focus .unity-base-slider__dragger-border {
  width: 18px;
  height: 18px;
}

.unity-base-slider__drag-container {
  flex-grow: 1;
}

.unity-base-slider--horizontal .unity-base-slider__drag-container {
  min-width: 20px;
}

.unity-base-slider--horizontal .unity-base-slider__text-field {
  width: 50px;
  height: 18px;
  margin: 0 0 0 4px;
}

/* ---- MinMaxSlider ---------------------------------------------------- */

.unity-min-max-slider__input {
  min-height: 16px;
  overflow: visible;
}

.unity-min-max-slider__tracker {
  top: 6px;
  height: 2px;
  margin: 2px 1px 2px 0;
  border-width: 0;
}

.unity-min-max-slider__dragger {
  height: 10px;
  margin-top: 4px;
  border-width: 1px 0;
  border-radius: 0;
  position: absolute;
}

.unity-min-max-slider__min-thumb,
.unity-min-max-slider__max-thumb {
  width: 7px;
  height: 10px;
  margin-top: -1px;
  border-width: 0;
  position: absolute;
}

.unity-min-max-slider__min-thumb {
  border-right-width: 1px;
  border-radius: 5px 0 0 5px;
}

.unity-min-max-slider__max-thumb {
  border-left-width: 1px;
  border-radius: 0 5px 5px 0;
}

.unity-min-max-slider__min-thumb.unity-min-max-slider--movable,
.unity-min-max-slider__max-thumb.unity-min-max-slider--movable {
  border-width: 1px;
}

/* ---- Foldout --------------------------------------------------------- */

.unity-foldout {
  margin-top: 0;
}

.unity-foldout__toggle > .unity-toggle__input {
  margin-top: 0;
}

.unity-foldout__toggle > .unity-toggle__input > .unity-toggle__checkmark {
  width: 13px;
  height: 13px;
  margin: 1px 5px 0 0;
  align-self: center;
}

.unity-foldout__toggle .unity-text-element {
  margin-top: 0;
  margin-left: -2px;
  padding-top: 1px;
  padding-left: 0;
}

.unity-foldout__content {
  margin-left: 15px;
}

.unity-foldout .unity-base-field__label {
  min-width: 135px;
}

/* ---- HelpBox, ProgressBar -------------------------------------------- */

.unity-help-box {
  flex-direction: row;
  align-items: center;
  margin: 1px 3px;
  padding: 2px;
  border-width: 1px;
  border-radius: 3px;
}

.unity-help-box__label {
  margin: 0;
  padding: 0 1px 0 0;
  font-size: 10px;
  white-space: normal;
  flex-shrink: 1;
}

.unity-help-box__icon {
  min-width: 34px;
  max-width: 34px;
  min-height: 32px;
  max-height: 32px;
  margin: 0;
  -unity-background-scale-mode: scale-to-fit;
}

.unity-progress-bar {
  margin: 1px 3px;
  padding: 0 0 1px 0;
  flex-shrink: 0;
}

.unity-progress-bar__background {
  height: 19px;
  border-width: 1px;
  border-radius: 0;
}

.unity-progress-bar__progress {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  border-radius: 0;
}

.unity-progress-bar__title-container {
  flex-direction: row;
  justify-content: center;
  flex-grow: 1;
}

.unity-progress-bar__title {
  margin: 1px 0;
  padding: 0 2px 0 1px;
  font-size: 12px;
  flex-grow: 1;
  -unity-text-align: middle-center;
}

/* ---- ColorField ------------------------------------------------------ */

.unity-color-field__input {
  flex-direction: row;
  flex-grow: 1;
  flex-shrink: 0;
  flex-basis: auto;
  min-height: 16px;
  border-width: 1px;
  border-radius: 3px;
}

.unity-color-field__color-container {
  flex-grow: 1;
}

.unity-color-field__color {
  flex-grow: 1;
}

.unity-color-field__gradient-container {
  position: absolute;
  width: 100%;
  height: 100%;
  flex-direction: row;
}

.unity-color-field__gradient-container > VisualElement {
  flex-grow: 1;
}

#unity-alpha-gradient-left {
  background-image: url("editor-alpha-up.svg");
}

#unity-alpha-gradient-right {
  background-image: url("editor-alpha-down.svg");
}

.unity-color-field__hdr {
  position: absolute;
  width: 100%;
  height: 100%;
  font-size: 10px;
  -unity-text-align: middle-center;
}

.unity-color-field__color-container > .unity-base-field__label--mixed-value {
  position: absolute;
}

.unity-color-field__color-container > .unity-progress-bar {
  margin: 0;
  padding: 0;
}

.unity-color-field__color-container .unity-progress-bar__container {
  height: 3px;
}

.unity-color-field__color-container .unity-progress-bar__background {
  border-width: 0;
  opacity: 1;
}

.unity-color-field__color-container .unity-progress-bar__progress {
  opacity: 1;
}

.unity-color-field__eyedropper {
  width: 18px;
  height: 100%;
  flex-grow: 0;
  flex-shrink: 0;
  flex-basis: auto;
  -unity-background-scale-mode: scale-to-fit;
}

/* ---- CurveField, GradientField --------------------------------------- */

.unity-curve-field__input {
  margin-top: 1px;
  min-height: 15px;
  border-width: 1px;
}

.unity-gradient-field__input {
  min-height: 16px;
  border-width: 1px;
}

.unity-gradient-field__background {
  position: absolute;
  left: 1px;
  top: 1px;
  right: 1px;
  bottom: 1px;
  background-image: url("editor-checker.svg");
  background-repeat: repeat;
  background-size: 30px 30px;
  background-position-x: left;
  background-position-y: top;
}

.unity-gradient-field__content {
  flex-grow: 1;
}

/* ---- ObjectField ----------------------------------------------------- */

.unity-object-field__input {
  flex-direction: row;
  border-width: 1px;
  border-radius: 3px;
}

.unity-object-field__object {
  flex-direction: row;
  flex-grow: 1;
  flex-shrink: 0;
  flex-basis: 0%;
}

.unity-object-field-display__icon {
  max-width: 14px;
  max-height: 12px;
  margin: 2px 0;
  padding: 0 0 0 2px;
  align-self: center;
}

.unity-object-field-display__label {
  margin: 0 0 0 2px;
  padding: 1px 2px 0 0;
  flex-grow: 1;
  flex-shrink: 0;
  flex-basis: 0%;
  overflow: hidden;
}

.unity-object-field-display__label--value-null {
  opacity: 0.7;
}

.unity-object-field__selector {
  width: 18px;
  height: 16px;
  flex-shrink: 0;
  align-self: center;
}

/* ---- PropertyField, InspectorElement --------------------------------- */

.unity-inspector-element {
  flex-grow: 1;
}

.unity-inspector-element--uie {
  padding: 2px 6px 0 15px;
}

.unity-inspector-element .unity-property-field__label {
  padding-left: 1px;
  overflow: hidden;
}

.unity-base-field__inspector-field {
  margin-right: -2px;
}

.unity-composite-field__field-spacer {
  visibility: hidden;
}

/* The object picker image is drawn at its own size: inert. */
.unity-object-field__selector {
  -unity-slice-left: 1;
  -unity-slice-right: 1;
  -unity-slice-top: 1;
  -unity-slice-bottom: 1;
}

#unity-prefab-override-bars-container,
#unity-live-property-bars-container {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

/* ---- Toolbar --------------------------------------------------------- */

.unity-toolbar {
  flex-direction: row;
  flex-shrink: 0;
  height: 21px;
  border-bottom-width: 1px;
  white-space: nowrap;
}

.unity-toolbar-button,
.unity-toolbar-toggle,
.unity-toolbar-menu {
  margin: 0 0 0 -1px;
  padding: 1px 4px 0 4px;
  border-width: 0 1px;
  border-radius: 0;
  flex-shrink: 1;
  white-space: nowrap;
}

.unity-toolbar-button {
  -unity-text-align: middle-center;
}

.unity-toolbar-toggle {
  flex-direction: row;
  flex-shrink: 0;
  overflow: hidden;
}

.unity-toolbar-toggle > .unity-toggle__input {
  flex-grow: 1;
  flex-shrink: 0;
  margin: 0 0 1px 0;
  overflow: hidden;
}

.unity-toolbar-toggle .unity-toggle__checkmark {
  width: 0;
  height: 0;
  background-image: none;
}

.unity-toolbar-toggle .unity-toggle__text {
  flex-shrink: 0;
}

.unity-toolbar-toggle > .unity-base-field__label {
  margin: 0 2px 0 1px;
  padding: 1px 2px 0 1px;
  flex-grow: 1;
  align-self: center;
}

.unity-toolbar-menu {
  flex-direction: row;
  align-items: center;
  padding-right: 2px;
}

.unity-toolbar-menu__text {
  flex-grow: 1;
  -unity-text-align: middle-left;
  overflow: hidden;
}

.unity-toolbar-menu__arrow {
  width: 12px;
  height: 12px;
  align-self: center;
}

.unity-toolbar-spacer {
  width: 6px;
}

.unity-toolbar-spacer--flexible {
  flex-grow: 1;
  flex-basis: 0%;
  width: auto;
}

.unity-toolbar-breadcrumbs {
  flex-direction: row;
}

.unity-toolbar-breadcrumbs__item {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin: 0 0 0 -10px;
  padding: 0 15px 0 20px;
  border-width: 0;
  border-radius: 0;
  -unity-text-align: middle-center;
  white-space: nowrap;
  -unity-slice-left: 10;
  -unity-slice-right: 10;
}

.unity-toolbar-breadcrumbs__first-item {
  margin-left: 0;
  padding-left: 10px;
}

/* ---- Search fields ---------------------------------------------------- */

.unity-search-field-base {
  width: 295px;
  min-width: 32px;
  min-height: 16px;
  margin: 2px 2px 2px 4px;
  padding: 0;
  flex-direction: row;
  flex-grow: 0;
  flex-shrink: 0;
  align-items: center;
  border-width: 1px;
  border-radius: 3px;
}

.unity-search-field-base__search-button {
  width: 8px;
  height: 8px;
  margin: 0 0 0 2px;
  padding: 0;
  border-width: 0;
  border-radius: 0;
}

.unity-search-field-base--popup > .unity-search-field-base__search-button {
  width: 11px;
  height: 8px;
}

.unity-search-field-base__text-field {
  margin: 0 3px 0 2px;
  flex-grow: 1;
  flex-shrink: 1;
}

.unity-search-field-base__text-field__input,
.unity-search-field-base__text-field:hover > .unity-search-field-base__text-field__input,
.unity-search-field-base__text-field:focus > .unity-search-field-base__text-field__input {
  min-height: 11px;
  height: 14px;
  margin: 0;
  padding: 0 14px 0 0;
  border-width: 0;
  font-size: 11px;
  flex-grow: 1;
}

.unity-search-field-base__cancel-button {
  width: 14px;
  height: 13px;
  margin: 0;
  padding: 0;
  border-width: 0;
  border-radius: 0;
}

.unity-search-field-base__cancel-button--off {
  background-image: none;
}

/* ---- Resolved values that change no box (measured with every resolved
   style value: ed-*.json) ---------------------------------------------- */

/* Editor cursors: text over text inputs, slide over dragger labels. */
.unity-base-text-field__input,
.unity-text-element__selectable {
  cursor: text;
}

.unity-base-field__label--with-dragger {
  cursor: slide-arrow;
}

/* Unity's slices of its field image (no image here: inert). */
.unity-object-field-display {
  -unity-slice-left: 4;
  -unity-slice-right: 4;
  -unity-slice-top: 4;
  -unity-slice-bottom: 4;
}

.unity-composite-field__field-spacer {
  visibility: hidden;
}

/* The object picker image is drawn at its own size: inert. */
.unity-object-field__selector {
  -unity-slice-left: 1;
  -unity-slice-right: 1;
  -unity-slice-top: 1;
  -unity-slice-bottom: 1;
}

#unity-prefab-override-bars-container,
#unity-live-property-bars-container {
  overflow: hidden;
}

.unity-rendering-layer-mask-field {
  flex-wrap: wrap;
}

/* ---- Menus (GenericDropdownMenu: UxmlDocument.show_context_menu) ------ */
/* Not measured: Unity's editor panels show their context menus as OS
 * menus. The geometry is the runtime menu's at the editor font size; the
 * skin sheets give the colours of the skin. */
.unity-base-dropdown__container-outer {
  border-width: 1px;
  margin-top: 4px;
}

.unity-base-dropdown__container-inner {
  padding: 4px 0;
}

.unity-base-dropdown__item {
  flex-direction: row;
  min-width: 20px;
  min-height: 20px;
  padding-right: 20px;
  -unity-text-align: middle-left;
}

.unity-base-dropdown__item-content {
  flex-direction: row;
}

.unity-base-dropdown__checkmark {
  width: 16px;
  height: 16px;
  min-width: 16px;
  min-height: 16px;
  margin: 2px 4px;
  background-image: url("check.svg");
  visibility: hidden;
}

.unity-base-dropdown__item:checked .unity-base-dropdown__checkmark {
  visibility: visible;
}

.unity-base-dropdown__label {
  -unity-text-align: middle-left;
}

.unity-base-dropdown__separator-container {
  padding: 3px 0;
}

.unity-base-dropdown__separator-line {
  height: 1px;
}
