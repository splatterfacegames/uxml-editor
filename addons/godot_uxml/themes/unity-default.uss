/*
 * godot-uxml default theme.
 *
 * Written by godot-uxml from values measured in Unity 6000.3.24f1 with its
 * default runtime theme (unity-theme://default) at pixelsPerPoint 1, using
 * tools/unity-dump. The dumps are bench/parity/unity/ctl-*.json. This is
 * not Unity's stylesheet: only the measured resolved values are recorded
 * here, as rules on Unity's documented class and part names.
 *
 * UxmlTheme splices this sheet ahead of every author sheet and ranks it
 * below every author rule, as Unity ranks its theme (measured:
 * states-disabled, ctl-styled-parts).
 *
 * Disabled look: Unity's SetEnabled(false) adds `unity-disabled` to the
 * element itself (not its subtree), and only that element resolves
 * opacity 0.5 (ctl-disabled, states-disabled). The runtime paints opacity
 * on the element's control, so the subtree dims once, as in Unity.
 *
 * The images (check, arrows, help box icons) are godot-uxml's own SVGs.
 */

/* SetEnabled(false) / enabled="false": the element itself dims. */
.unity-disabled {
  opacity: 0.5;
}

/* Root: Unity's panel root gives every document its text colour and size. */
UXML {
  color: rgb(27, 27, 27);
  font-size: 14px;
}

/* ---- Label, Box ------------------------------------------------------ */

.unity-label {
  margin: 4px 4px 2px 2px;
  padding: 4px 2px 4px 1px;
  flex-shrink: 0;
  white-space: nowrap;
}

.unity-box {
  background-color: rgb(222, 222, 222);
  border-width: 1px;
  border-color: rgb(85, 85, 85);
}

/* ---- Button ---------------------------------------------------------- */

.unity-button {
  margin: 2px 4px;
  padding: 10px 12px;
  border-width: 1px;
  border-color: rgb(149, 149, 149);
  background-color: rgb(188, 188, 188);
  flex-shrink: 0;
  -unity-text-align: middle-center;
  white-space: nowrap;
}

.unity-button:hover {
  border-color: rgb(128, 128, 128);
  background-color: rgb(209, 209, 209);
}

.unity-button:active {
  border-color: rgb(100, 100, 100);
  background-color: rgb(149, 149, 149);
}

/* Measured with :hover:active:focus: the focus border wins. */
.unity-button:focus {
  border-color: rgb(0, 106, 166);
}

.unity-button:disabled {
  border-color: rgb(126, 126, 126);
  background-color: rgb(149, 149, 149);
}

/* ---- BaseField: label beside input ----------------------------------- */

.unity-base-field {
  margin: 2px 4px;
  flex-direction: row;
  flex-shrink: 0;
}

/* Label width rule: at least 150px, wider for longer text; it never
   shrinks (a narrow field lets the label overflow). */
.unity-base-field__label {
  min-width: 150px;
  text-overflow: ellipsis;
}

.unity-base-field__input {
  flex-grow: 1;
  flex-shrink: 0;
  flex-basis: 0%;
}

/* Inputs that keep the auto basis (measured: ctl-slider*, ctl-radio,
   ctl-togglebuttongroup). A narrow field with a 0% input basis lets the
   input collapse to 0 (ctl-basefield). */
.unity-base-slider__input,
.unity-radio-button__input,
.unity-button-group {
  flex-basis: auto;
}

.unity-base-field:focus > .unity-base-field__label {
  color: rgb(0, 82, 106);
}

/* ==== Input controls ==================================================
 * Slider, SliderInt, MinMaxSlider, TextField, the numeric, composite,
 * popup and enum fields (runtime/controls/uxml_input_parts.gd).
 * Measured: bench/parity/unity/ctl-slider*, ctl-minmaxslider,
 * ctl-textfield*, ctl-numeric*, ctl-vectors, ctl-rects, ctl-dropdown*,
 * ctl-enum*, ctl-hover-*, ctl-focus-minmax.
 */

/* ---- Slider, SliderInt ------------------------------------------------ */

.unity-base-slider--horizontal {
  min-height: 24px;
}

.unity-base-slider--vertical {
  margin: 2px 1px;
  flex-direction: column;
  width: 40px;
  min-width: 24px;
}

.unity-base-slider--horizontal > .unity-base-slider__input {
  flex-direction: row;
  height: 100%;
}

.unity-base-slider--vertical > .unity-base-slider__input {
  width: 100%;
}

.unity-base-slider__drag-container {
  flex-grow: 1;
}

.unity-base-slider__tracker {
  position: absolute;
  border-width: 1px;
  border-color: rgb(100, 100, 100);
  background-color: rgb(126, 126, 126);
}

.unity-base-slider--horizontal .unity-base-slider__tracker {
  height: 6px;
  top: 50%;
  left: 0;
  right: 0;
  margin-top: -3px;
}

.unity-base-slider--vertical .unity-base-slider__tracker {
  width: 6px;
  left: 50%;
  top: 0;
  bottom: 0;
  margin-left: -3px;
}

.unity-base-slider__fill {
  position: absolute;
  background-color: rgb(240, 240, 240);
}

.unity-base-slider__dragger-border {
  display: none;
}

.unity-base-slider__dragger {
  position: absolute;
  border-width: 1px;
  border-color: rgb(100, 100, 100);
  background-color: rgb(240, 240, 240);
}

.unity-base-slider--horizontal .unity-base-slider__dragger {
  width: 8px;
  height: 24px;
  top: 50%;
  margin-top: -12px;
}

.unity-base-slider--vertical .unity-base-slider__dragger {
  width: 24px;
  height: 8px;
  left: 50%;
  margin-left: -12px;
}

.unity-base-slider__dragger:hover {
  border-color: rgb(50, 50, 50);
}

/* The dragger of a focused slider (Unity's --movable class). */
.unity-base-slider__dragger.unity-base-slider--movable {
  border-width: 2px;
  border-color: rgb(0, 106, 166);
}

.unity-base-slider:disabled .unity-base-slider__dragger {
  border-color: rgb(126, 126, 126);
  background-color: rgb(128, 128, 128);
}

.unity-base-slider:disabled .unity-base-slider__fill {
  background-color: rgb(50, 50, 50);
}

.unity-base-slider--horizontal .unity-base-slider__text-field {
  width: 55px;
  margin: 0 0 0 4px;
}

.unity-base-slider--vertical .unity-base-slider__text-field {
  height: 18px;
  min-width: 20px;
  margin: 4px 0 0 0;
}

/* ---- MinMaxSlider ----------------------------------------------------- */

.unity-min-max-slider {
  margin: 1px 4px;
  min-height: 24px;
}

.unity-min-max-slider__input {
  min-height: 16px;
  flex-basis: 0%;
}

.unity-min-max-slider__tracker {
  position: absolute;
  height: 6px;
  top: 50%;
  left: 0;
  right: 0;
  margin-top: -3px;
  border-width: 1px;
  border-color: rgb(100, 100, 100);
  background-color: rgb(126, 126, 126);
}

.unity-min-max-slider__dragger {
  position: absolute;
  height: 6px;
  /* Unity's slices of its dragger image (no image here: inert). */
  -unity-slice-left: 10;
  -unity-slice-right: 10;
  top: 50%;
  margin-top: -3px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-color: rgb(100, 100, 100);
  background-color: rgb(188, 188, 188);
}

.unity-min-max-slider__dragger:hover {
  border-color: rgb(50, 50, 50);
}

.unity-min-max-slider__min-thumb,
.unity-min-max-slider__max-thumb {
  position: absolute;
  min-width: 8px;
  min-height: 24px;
  margin-top: -10px;
  border-width: 1px;
  border-color: rgb(100, 100, 100);
  background-color: rgb(240, 240, 240);
}

/* The focused thumb (Unity's --movable class). */
.unity-min-max-slider__min-thumb.unity-min-max-slider--movable,
.unity-min-max-slider__max-thumb.unity-min-max-slider--movable {
  border-width: 2px;
  border-color: rgb(0, 106, 166);
}

/* ---- TextField and the numeric fields --------------------------------- */

.unity-base-text-field {
  white-space: nowrap;
  --unity-cursor-color: rgb(0, 0, 0);
  --unity-selection-color: rgba(61, 128, 223, 0.65);
}

.unity-base-text-field__input {
  flex-direction: row;
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0%;
  /* Unity's input clips its text and does not bound the text width. */
  overflow: scroll;
  padding: 10px;
  border-width: 1px;
  border-color: rgb(100, 100, 100);
  background-color: rgb(240, 240, 240);
}

.unity-base-text-field__input--single-line {
  -unity-text-align: middle-left;
}

.unity-base-text-field__input--placeholder {
  color: rgb(88, 88, 88);
}

.unity-base-text-field:hover > .unity-base-text-field__input {
  border-color: rgb(50, 50, 50);
}

.unity-base-text-field:focus > .unity-base-text-field__input {
  border-color: rgb(0, 106, 166);
}

.unity-base-text-field:disabled > .unity-base-text-field__input {
  background-color: rgb(209, 209, 209);
}

.unity-base-text-field__multiline-container {
  flex-grow: 1;
  flex-shrink: 0;
  overflow: scroll;
}

/* A multiline field with a vertical Scroller: a ScrollView holds the text
   element (Unity TextInputBase.SetMultiline; measured:
   ctl-textfield-multiline). */
.unity-base-text-field__input--multiline--scroll-view {
  flex-direction: column;
  flex-shrink: 0;
  overflow: hidden;
}

.unity-scroll-view--inner-input-field-component {
  flex-grow: 1;
}

.unity-scroll-view__content-viewport--inner-input-field-component {
  height: 100%;
}

.unity-scroll-view__content-container--inner-input-field-component {
  min-height: 100%;
}

.unity-text-element--inner-input-field-component--scroll-view {
  flex-shrink: 0;
  min-width: 100%;
  min-height: 100%;
  padding-right: 2px;
}

.unity-text-element--inner-input-field-component {
  flex-grow: 1;
  flex-shrink: 0;
  padding-left: 2px;
  padding-right: 2px;
}

/* ---- Composite fields (vectors, rects, bounds) ------------------------ */

/* The runtime theme stacks the sub-fields: each sub-field is a whole field
   with a 150px label (measured: ctl-vectors, ctl-rects). */
.unity-composite-field__field-spacer {
  visibility: hidden;
}

/* ---- DropdownField, EnumField ----------------------------------------- */

.unity-base-popup-field__input,
.unity-enum-field__input {
  flex-direction: row;
  flex-grow: 1;
  flex-shrink: 0;
  flex-basis: 0%;
  margin-left: 4px;
  padding: 10px 12px;
  border-width: 1px;
  border-color: rgb(149, 149, 149);
  background-color: rgb(188, 188, 188);
  -unity-text-align: middle-left;
}

.unity-base-popup-field__input {
  min-width: 55px;
}

.unity-base-popup-field:hover > .unity-base-popup-field__input,
.unity-enum-field:hover > .unity-enum-field__input {
  border-color: rgb(128, 128, 128);
  background-color: rgb(209, 209, 209);
}

/* The field is :active while its menu is open (an EnumField keeps its
   look: ctl-enum-open). */
.unity-base-popup-field:active > .unity-base-popup-field__input {
  border-color: rgb(100, 100, 100);
  background-color: rgb(149, 149, 149);
}

.unity-base-popup-field:focus > .unity-base-popup-field__input,
.unity-enum-field:focus > .unity-enum-field__input {
  border-color: rgb(0, 106, 166);
}

.unity-base-popup-field:disabled > .unity-base-popup-field__input,
.unity-enum-field:disabled > .unity-enum-field__input {
  border-color: rgb(126, 126, 126);
  background-color: rgb(149, 149, 149);
}

.unity-base-popup-field__text,
.unity-enum-field__text {
  flex-grow: 1;
  margin-right: 40px;
}

.unity-base-popup-field__arrow,
.unity-enum-field__arrow {
  width: 10px;
  height: 10px;
  align-self: center;
  background-image: url("dropdown-arrow.svg");
  -unity-background-image-tint-color: rgb(50, 50, 50);
}

/* The popup menu (GenericDropdownMenu; runtime/controls/uxml_popup_menu.gd). */
.unity-base-dropdown__container-outer {
  border-width: 1px;
  border-color: rgb(50, 50, 50);
  margin-top: 4px;
}

.unity-base-dropdown__container-inner {
  padding: 4px 0;
  background-color: rgb(240, 240, 240);
}

.unity-base-dropdown__item {
  flex-direction: row;
  min-width: 20px;
  min-height: 20px;
  padding-right: 20px;
  -unity-text-align: middle-left;
}

.unity-base-dropdown__item:hover {
  background-color: rgb(0, 106, 166);
}

.unity-base-dropdown__item-content {
  flex-direction: row;
}

.unity-base-dropdown__checkmark {
  width: 20px;
  height: 20px;
  min-width: 20px;
  min-height: 20px;
  margin: 5px;
  background-image: url("check.svg");
  -unity-background-image-tint-color: rgb(27, 27, 27);
  visibility: hidden;
}

.unity-base-dropdown__item:checked .unity-base-dropdown__checkmark {
  visibility: visible;
}

.unity-base-dropdown__item:hover .unity-base-dropdown__checkmark {
  -unity-background-image-tint-color: rgb(255, 255, 255);
}

.unity-base-dropdown__label {
  -unity-text-align: middle-left;
}

.unity-base-dropdown__item:hover .unity-base-dropdown__label {
  color: rgb(255, 255, 255);
}

/* ---- Toggle ---------------------------------------------------------- */

.unity-toggle__input {
  flex-direction: row;
}

.unity-toggle__checkmark {
  width: 24px;
  height: 24px;
  border-width: 1px;
  border-color: rgb(100, 100, 100);
  background-color: rgb(240, 240, 240);
  align-self: center;
  flex-shrink: 0;
  -unity-background-image-tint-color: rgb(50, 50, 50);
}

.unity-toggle__input:checked > .unity-toggle__checkmark {
  background-image: url("check.svg");
}

.unity-toggle__input:hover > .unity-toggle__checkmark {
  border-color: rgb(50, 50, 50);
}

.unity-toggle:focus > .unity-toggle__input > .unity-toggle__checkmark {
  border-color: rgb(0, 106, 166);
}

.unity-toggle:disabled > .unity-toggle__input > .unity-toggle__checkmark {
  border-color: rgb(126, 126, 126);
  background-color: rgb(149, 149, 149);
}

.unity-toggle__text,
.unity-radio-button__text {
  margin: 0 4px 2px 1px;
  align-self: center;
}

.unity-foldout__toggle:focus .unity-foldout__text {
  color: rgb(0, 82, 106);
}

/* ---- RadioButton ----------------------------------------------------- */

.unity-radio-button {
  margin-bottom: 3px;
}

.unity-radio-button__input {
  flex-direction: row;
}

.unity-radio-button__label {
  padding-top: 0;
  padding-bottom: 0;
}

.unity-radio-button__checkmark-background {
  width: 24px;
  height: 24px;
  padding-top: 5px;
  border-width: 1px;
  border-color: rgb(100, 100, 100);
  border-radius: 12px;
  background-color: rgb(240, 240, 240);
  align-self: center;
  flex-shrink: 0;
}

.unity-radio-button__input:hover > .unity-radio-button__checkmark-background {
  border-color: rgb(50, 50, 50);
}

.unity-radio-button:focus > .unity-radio-button__input > .unity-radio-button__checkmark-background {
  border-color: rgb(0, 106, 166);
}

.unity-radio-button__checkmark {
  width: 12px;
  height: 12px;
  border-radius: 6px;
  background-color: rgb(50, 50, 50);
  align-self: center;
  flex-shrink: 0;
  display: none;
}

.unity-radio-button__input:checked > .unity-radio-button__checkmark-background > .unity-radio-button__checkmark {
  display: flex;
}

/* ---- ToggleButtonGroup ----------------------------------------------- */

.unity-toggle-button-group {
  align-items: center;
}

.unity-button-group {
  flex-direction: row;
  flex-grow: 1;
  flex-shrink: 1;
}

.unity-button-group__button {
  margin-left: 0;
  margin-right: 0;
  border-right-width: 0;
}

.unity-button-group__button--right {
  margin-right: 4px;
  border-right-width: 1px;
}

.unity-button-group__button--standalone {
  margin-left: 4px;
  margin-right: 4px;
  border-right-width: 1px;
}

.unity-button-group__button:checked {
  border-left-color: rgb(149, 149, 149);
  background-color: rgb(149, 149, 149);
}

.unity-button-group__button:checked:hover {
  background-color: rgb(162, 162, 162);
}

/* ---- GroupBox -------------------------------------------------------- */

.unity-group-box {
  margin: 6px 4px 2px 4px;
  padding: 5px 0 5px 3px;
  flex-shrink: 0;
}

.unity-group-box__label {
  margin: -5px 4px 5px 2px;
}

/* ---- HelpBox --------------------------------------------------------- */

.unity-help-box {
  margin: 1px 3px;
  padding: 2px;
  border-width: 1px;
  border-color: rgb(154, 154, 154);
  border-radius: 3px;
  background-color: rgb(202, 202, 202);
  flex-direction: row;
  align-items: center;
}

.unity-help-box__label {
  padding: 4px 1px 4px 0;
  flex-shrink: 1;
  white-space: normal;
}

.unity-help-box__icon {
  min-width: 34px;
  max-width: 34px;
  min-height: 32px;
  max-height: 32px;
  -unity-background-scale-mode: scale-to-fit;
}

.unity-help-box__icon--info {
  background-image: url("info.svg");
}

.unity-help-box__icon--warning {
  background-image: url("warning.svg");
}

.unity-help-box__icon--error {
  background-image: url("error.svg");
}

/* ---- PopupWindow ----------------------------------------------------- */

.unity-popup-window {
  padding-top: 3px;
  border-width: 1px;
  border-color: rgb(102, 102, 102);
  border-radius: 8px 8px 0 0;
  background-color: rgba(179, 179, 179, 0.95);
  -unity-text-align: upper-center;
}

.unity-popup-window__content-container {
  padding: 24px 4px 4px 4px;
  -unity-text-align: upper-left;
}

/* ---- Foldout --------------------------------------------------------- */

.unity-foldout__content {
  margin-left: 30px;
}

.unity-foldout__checkmark {
  width: 22px;
  height: 22px;
  margin: 0 4px;
  border-width: 0;
  border-color: rgba(0, 0, 0, 0);
  background-color: rgba(0, 0, 0, 0);
  background-image: url("arrow-right.svg");
}

.unity-foldout__input:checked > .unity-foldout__checkmark {
  border-color: rgb(100, 100, 100);
  background-image: url("arrow-down.svg");
}

.unity-foldout__input:hover > .unity-foldout__checkmark {
  border-color: rgb(50, 50, 50);
}

.unity-foldout__toggle:focus > .unity-foldout__input > .unity-foldout__checkmark {
  border-color: rgb(0, 106, 166);
}

.unity-foldout__toggle:disabled > .unity-foldout__input > .unity-foldout__checkmark {
  background-color: rgba(0, 0, 0, 0);
}

/* ---- ProgressBar ----------------------------------------------------- */

.unity-progress-bar {
  margin: 4px;
  flex-shrink: 0;
}

.unity-progress-bar__container {
  min-height: 24px;
  max-height: 24px;
}

.unity-progress-bar__background {
  border-width: 1px;
  border-color: rgb(128, 128, 128);
  background-color: rgb(188, 188, 188);
  flex-grow: 1;
}

.unity-progress-bar__progress {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  margin: 2px;
  background-color: rgb(231, 231, 231);
}

.unity-progress-bar__title-container {
  flex-direction: row;
  flex-grow: 1;
  justify-content: center;
}

.unity-progress-bar__title {
  margin: 0;
  padding: 10px 12px;
  -unity-text-align: middle-center;
}


/* ---- Resolved values that change no box (measured with every resolved
   style value: bench/parity/unity/ctl-*.json, uss-cursor.json) --------- */

/* Unity clips these controls and parts. */
.unity-base-field__label,
.unity-base-text-field,
.unity-toggle,
.unity-toggle__input,
.unity-radio-button,
.unity-radio-button__input,
.unity-radio-button-group,
.unity-button-group,
.unity-toggle-button-group,
.unity-composite-field,
.unity-composite-field__input,
.unity-bounds-field,
.unity-bounds-field__input,
.unity-bounds-int-field,
.unity-bounds-int-field__input,
.unity-base-popup-field,
.unity-base-popup-field__input,
.unity-base-popup-field__text,
.unity-enum-field,
.unity-enum-field__input,
.unity-enum-field__text,
.unity-radio-button-group > .unity-base-field__input {
  overflow: hidden;
}

.unity-base-popup-field__input,
.unity-enum-field__input {
  white-space: nowrap;
}

/* A disabled MinMaxSlider: the dragger and thumbs turn grey. */
.unity-min-max-slider__dragger:disabled,
.unity-min-max-slider__min-thumb:disabled,
.unity-min-max-slider__max-thumb:disabled {
  background-color: rgb(128, 128, 128);
  border-color: rgb(126, 126, 126);
}

/* Separators of a context menu (GenericDropdownMenu.AddSeparator;
 * UxmlDocument.show_context_menu). Not measured: Unity's runtime theme has
 * the classes; the values here follow the menu's own spacing. */
.unity-base-dropdown__separator-container {
  padding: 3px 0;
}

.unity-base-dropdown__separator-line {
  height: 1px;
  background-color: rgb(153, 153, 153);
}
