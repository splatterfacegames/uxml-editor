# Text files are stored and checked out with LF. Godot reads either.
* text=auto eol=lf
*.png binary
*.woff2 binary
# Fixture projects are byte-exact test oracles (CRLF menu, LF others). Check
# out blob bytes verbatim on every platform.
fixtures/** -text
tests/fixtures/** -text
# The godot-uxml addon is a byte-exact copy of one godot-uxml commit
# (see godot-uxml.pin). Never let eol conversion touch it.
addons/godot_uxml/** -text
*.dll binary
